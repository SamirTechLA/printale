# Keep these values private: never place them in browser code or commit a real .env file.
OPENAI_API_KEY=
# Set to "teaser" to show the public coming-soon page. Use "full" to publish the studio.
PRINTALE_SITE_MODE=teaser
# Required in teaser mode for the password-protected /preview route and all generation APIs.
PRINTALE_PREVIEW_PASSWORD=choose-a-strong-private-password
# Peecho provides the API key in its sandbox or production dashboard.
PEECHO_API_KEY=
# The public HTTPS base URL from which Peecho can securely fetch final print files.
# This local 127.0.0.1 preview cannot be used by a print provider.
PEECHO_PUBLIC_FILE_BASE_URL=https://your-printale-domain.example
# Use "sandbox" while testing. Switch to "production" only after successful test orders.
PEECHO_ENV=sandbox
